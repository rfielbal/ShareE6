{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% if scategories|length %}
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.fichier) }}
        <p class="muted">PDF, PNG ou JPG. Taille maximale : 200 ko.</p>
        {% if form.user is defined %}{{ form_row(form.user) }}{% endif %}
        {% include 'fichier/_classement.html.twig' %}
        <div class="actions">{{ form_widget(form.envoyer) }}</div>
    {{ form_end(form) }}
{% else %}
    <p class="muted">Le dépôt sera disponible dès qu’une sous-catégorie aura été créée.</p>
    {% if is_granted('ROLE_ADMIN') %}<a class="btn" href="{{ path('app_liste_categories') }}">Préparer les catégories</a>{% endif %}
{% endif %}
