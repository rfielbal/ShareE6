{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}Modifier le classement · ShareE6{% endblock %}
{% block body %}
<a class="back-link" href="{{ path('app_liste_fichiers') }}">Retour aux fichiers</a>
<section class="card form-panel"><h1>Modifier le classement</h1><p class="file-name">{{ fichier.nomOriginal }}</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {% include 'fichier/_classement.html.twig' %}
        <div class="actions">{{ form_widget(form.enregistrer) }}<a class="btn secondary" href="{{ path('app_liste_fichiers') }}">Annuler</a></div>
    {{ form_end(form) }}
</section>
{% endblock %}
