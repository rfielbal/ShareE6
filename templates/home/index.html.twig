{% extends 'base.html.twig' %}
{% block title %}Accueil · ShareE6{% endblock %}
{% block body %}
<section class="home-intro" aria-labelledby="home-title">
    <div class="home-copy">
        <p class="eyebrow"><span></span>Votre espace personnel</p>
        {% if app.user %}
            <h1 id="home-title">Bonjour,<br><span>{{ app.user.prenom }}.</span></h1>
            <p class="intro-text">Déposez vos documents, classez-les et retrouvez-les dans votre espace.</p>
            <a class="text-link" href="{{ path('app_liste_fichiers') }}">Consulter les fichiers</a>
        {% else %}
            <h1 id="home-title">Vos fichiers.<br><span>Bien classés.</span></h1>
            <p class="intro-text">Un espace personnel pour déposer, organiser et retrouver vos documents.</p>
            <p class="home-note">PDF, images et catégories, réunis dans votre espace.</p>
        {% endif %}
    </div>
    <aside class="entry-panel" aria-label="Accéder à votre espace">
        <div class="entry-panel-top"><span class="eyebrow">ShareE6</span><span class="panel-symbol" aria-hidden="true">▤</span></div>
        <div class="entry-panel-body">
            <span class="entry-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><rect x="8" y="14" width="16" height="13" rx="3"/><path d="M11 14V10a5 5 0 0 1 10 0v4M16 19v3"/></svg></span>
            {% if app.user %}
                <h2>Votre espace de fichiers</h2><p>{{ app.user.email }}</p>
                <a class="btn wide" href="{{ path('app_ajout_fichier') }}">Déposer un fichier</a>
                <a class="panel-secondary" href="{{ path('app_profile') }}">Ouvrir mon profil</a>
            {% else %}
                <h2>Accéder à mes documents</h2><p>Connectez-vous pour retrouver vos fichiers et en déposer de nouveaux.</p>
                <a class="btn wide" href="{{ path('app_login') }}">Se connecter</a>
                <div class="panel-divider"><span>Première visite ?</span></div>
                <a class="panel-secondary" href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
        </div>
    </aside>
</section>
<section class="overview" aria-label="Dans votre espace">
    <p class="eyebrow overview-label">Dans votre espace</p>
    <div class="overview-grid">
        <article><div><h2>Déposer</h2><p>Ajoutez un PDF ou une image à votre espace personnel.</p></div></article>
        <article><div><h2>Classer</h2><p>Associez chaque document à une ou plusieurs sous-catégories.</p></div></article>
        <article><div><h2>Retrouver</h2><p>Consultez vos fichiers et téléchargez-les lorsque vous en avez besoin.</p></div></article>
    </div>
</section>
{% endblock %}
