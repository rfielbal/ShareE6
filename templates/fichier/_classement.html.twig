<fieldset class="classification">
    <legend>Classer le fichier</legend>
    <p class="muted">Choisissez une ou plusieurs sous-catégories.</p>
    {{ form_errors(form.scategories) }}
    {# Les cases suivent l'ordre de trouverPourClassement(). La catégorie sert de titre pour chaque groupe. #}
    {% set categorieId = null %}
    {% for scategorie in scategories %}
        {% if categorieId != scategorie.categorie.id %}
            {% set categorieId = scategorie.categorie.id %}
            <h3 class="category-label">{{ scategorie.categorie.libelle }}</h3>
        {% endif %}
        <div class="classification-choice">{{ form_widget(form.scategories[scategorie.id]) }}</div>
    {% endfor %}
</fieldset>
