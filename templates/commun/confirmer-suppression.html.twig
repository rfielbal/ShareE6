{% extends 'base.html.twig' %}
{% block title %}{{ titre }} · ShareE6{% endblock %}
{% block body %}
<a class="back-link" href="{{ path(retour) }}">Revenir à la liste</a>
<section class="card form-panel">
    <h1>{{ titre }}</h1>
    <p>Vous allez supprimer <strong class="file-name">{{ libelle }}</strong>.</p>
    <p class="muted">{{ message }}</p>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token(jeton) }}">
        <div class="actions"><button class="danger" type="submit">Confirmer la suppression</button><a class="btn secondary" href="{{ path(retour) }}">Annuler</a></div>
    </form>
</section>
{% endblock %}
