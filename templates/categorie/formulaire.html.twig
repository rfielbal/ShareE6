{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}{{ titre }} · ShareE6{% endblock %}
{% block body %}
<a class="back-link" href="{{ path('app_liste_categories') }}">Retour aux catégories</a>
<section class="card form-panel">
    <h1>{{ titre }}</h1>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {% if form.categorie is defined %}{{ form_row(form.categorie) }}{{ form_row(form.numero) }}{% endif %}
        {{ form_row(form.libelle) }}
        <div class="actions">{{ form_widget(form.enregistrer) }}<a class="btn secondary" href="{{ path('app_liste_categories') }}">Annuler</a></div>
    {{ form_end(form) }}
</section>
{% endblock %}
