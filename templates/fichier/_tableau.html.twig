{% if fichiers|length %}
<div class="table-responsive"><table class="table table-hover file-table mb-0">
    <thead><tr><th scope="col">Fichier</th>{% if afficherProprietaire|default(false) %}<th scope="col">Propriétaire</th>{% endif %}<th scope="col">Classement</th><th scope="col">Actions</th></tr></thead>
    <tbody>{% for fichier in fichiers %}
    <tr>
        <td><a class="file-name" href="{{ path('app_telechargement_fichier', {id: fichier.id}) }}">{{ fichier.nomOriginal }}</a>
            <p class="file-meta">{{ fichier.extension|upper }} · {{ (fichier.taille / 1000)|number_format(1, ',', ' ') }} ko<br>{{ fichier.dateEnvoi|date('d/m/Y à H:i', 'Europe/Paris') }}</p>
        </td>
        {% if afficherProprietaire|default(false) %}<td>{{ fichier.user.prenom }} {{ fichier.user.nom }}</td>{% endif %}
        <td>{% for sc in fichier.scategories %}<span class="classification-tag">{{ sc.categorie.libelle }} / {{ sc.libelle }}</span>{% else %}<span class="muted">Sans classement</span>{% endfor %}</td>
        <td><div class="actions file-actions">
            <a class="btn secondary" href="{{ path('app_telechargement_fichier', {id: fichier.id}) }}">Télécharger<span class="visually-hidden"> {{ fichier.nomOriginal }}</span></a>
            <a class="btn secondary" href="{{ path('app_modifier_classement', {id: fichier.id}) }}">Classer<span class="visually-hidden"> {{ fichier.nomOriginal }}</span></a>
            <a class="btn danger" href="{{ path('app_supprimer_fichier', {id: fichier.id}) }}">Supprimer<span class="visually-hidden"> {{ fichier.nomOriginal }}</span></a>
        </div></td>
    </tr>
    {% endfor %}</tbody>
</table></div>
{% else %}<p class="muted mb-0">Aucun fichier déposé pour le moment.</p>{% endif %}
